{
  "files": [],
  "references": [
    { "path": "./tsconfig.app.json" },
    { "path": "./tsconfig.node.json" }
  ],
  "compilerOptions": {
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "bundler",
    "esModuleInterop": true,          // often needed alongside
    "allowSyntheticDefaultImports": true,  // helpful in some setups
    "paths": {
      "@/*": ["./src/*"]
    }
  }
}